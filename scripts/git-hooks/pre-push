#!/bin/sh
# Reject version bumps on ordinary pushes, and tags that do not match packages.
# Install: git config core.hooksPath scripts/git-hooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="python3"
fi
ZERO="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi
  case "$remote_ref" in
    refs/tags/v*)
      "$PYTHON" scripts/check_release_version.py "${remote_ref#refs/tags/}"
      ;;
    refs/heads/*)
      "$PYTHON" scripts/check_release_version.py --git-rules
      ;;
  esac
done
